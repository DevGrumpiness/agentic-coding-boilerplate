# Environment variables template.
#
# Copy to .env (or .env.local) and fill in real values. Never commit .env.
# Keep this file in sync: every variable the app reads must appear here,
# with a placeholder value and a comment saying where to get the real one.
#
# Why this matters for agentic coding: if the agent cannot find the variables
# it needs, it tends to invent them, stub the integration, or mock the service
# and then report that "everything works" against the mock. A complete
# .env.example plus a real .env removes that failure mode.

# --- App -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Connection string for the real dev database. Use a local instance or a
# dedicated dev branch of your hosted DB, never production.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me

# --- Third-party services --------------------------------------------------
# One block per integration. Note the dashboard or docs page for each key.
# EXAMPLE_API_KEY=
# EXAMPLE_API_URL=https://api.example.com
